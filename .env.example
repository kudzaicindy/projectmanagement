# Copy to apps/api/.env and apps/web/.env as needed

# Database — native PostgreSQL (npm run db:local:ps) on port 5432
DATABASE_URL="postgresql://estatepm:estatepm@127.0.0.1:5432/estatepm?schema=public"

# Optional Docker Postgres on 5434: npm run db:docker — see docs/DATABASE.md

# API
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
UPLOAD_DIR="./uploads"

# Web (Vite)
VITE_API_URL="http://localhost:3001"
